# ---- Mode -------------------------------------------------------------
# simulated (default): no real calls; CALL-E is replaced by app/orchestrator/calle_gateway.py::SimulatedCalleGateway
# live: real CALL-E Developer API via calle-ai SDK. PLACES REAL PHONE CALLS.
CALLE_MODE=simulated

# ---- Live mode only ---------------------------------------------------
CALLE_API_KEY=
# Comma-separated E.164 numbers you own / are authorised to call. Anything else is refused.
CALLE_ALLOWED_PHONES=
# Public HTTPS URL that reaches this machine's /calle/webhook (e.g. via ngrok/cloudflared).
# If empty, use POST /calls/{call_id}/sync to poll instead.
PUBLIC_WEBHOOK_URL=

# Only for testing against a different CALL-E endpoint; leave unset normally.
# CALLE_BASE_URL=https://api.heycall-e.com

# ---- Common -----------------------------------------------------------
CRM_BASE_URL=http://127.0.0.1:8001
CALL_WINDOW=08:00-21:00
PTP_MAX_DAYS_AFTER_DUE=7
SIM_DELAY_SECONDS=3
